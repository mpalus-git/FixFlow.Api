{
  "openapi": "3.1.1",
  "info": {
    "title": "FixFlow API",
    "description": "Field service work order management API for dispatchers and technicians.",
    "version": "1"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log in with email and password",
        "description": "Returns a short-lived JWT access token and a refresh token that starts a new session. Wrong credentials and locked out accounts return the same 401 response, so the endpoint does not reveal whether an account exists. Requests are rate limited per client IP address.",
        "operationId": "Login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Exchange a refresh token for a new token pair",
        "description": "Rotates the refresh token: the submitted token is revoked and a new access token and refresh token are returned. Submitting a refresh token that was already used revokes every token of that session, which forces the user to log in again. Requests are rate limited per client IP address.",
        "operationId": "RefreshTokens",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokensResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Log out and revoke the current session",
        "description": "Revokes the submitted refresh token together with every token of its session. The access token stays valid until it expires. The response is 204 also when the refresh token is unknown or belongs to another user.",
        "operationId": "Logout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/users": {
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a user account",
        "description": "Creates an account with the given role and initial password. Only administrators can create accounts; there is no public registration.",
        "operationId": "CreateUser",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/clients": {
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Create a client",
        "description": "Creates a client with a postal address and contact details. Available to dispatchers and administrators.",
        "operationId": "CreateClient",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateClientRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "List active clients",
        "description": "Returns one page of active clients ordered by name. Archived clients are not listed. The optional search matches a fragment of the client name regardless of letter case.",
        "operationId": "ListClients",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "Page number, starting from 1.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "description": "Number of clients per page, from 1 to 100.",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 20
            }
          },
          {
            "name": "search",
            "in": "query",
            "description": "Case-insensitive fragment of the client name.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedResponseOfClientResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/clients/{clientId}": {
      "get": {
        "tags": [
          "Clients"
        ],
        "summary": "Get a client",
        "description": "Returns a client by identifier, including archived clients so that historical work orders keep their client details.",
        "operationId": "GetClient",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
      "put": {
        "tags": [
          "Clients"
        ],
        "summary": "Update a client",
        "description": "Replaces the name, address and contact details of an active client. Archived clients cannot be modified. Available to dispatchers and administrators.",
        "operationId": "UpdateClient",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateClientRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/clients/{clientId}/archive": {
      "post": {
        "tags": [
          "Clients"
        ],
        "summary": "Archive a client",
        "description": "Hides the client from lists while keeping it and its history available by identifier. Archiving an already archived client has no effect. Available to dispatchers and administrators.",
        "operationId": "ArchiveClient",
        "parameters": [
          {
            "name": "clientId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/devices": {
      "post": {
        "tags": [
          "Devices"
        ],
        "summary": "Create a device",
        "description": "Registers a device of an active client. The serial number is trimmed, stored in upper case and must be unique, also among archived devices. Available to dispatchers and administrators.",
        "operationId": "CreateDevice",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateDeviceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    },
    "/api/v1/devices/{deviceId}": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Get a device",
        "description": "Returns a device by identifier, including archived devices so that historical work orders keep their device details.",
        "operationId": "GetDevice",
        "parameters": [
          {
            "name": "deviceId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthTokensResponse": {
        "required": [
          "accessToken",
          "accessTokenExpiresAt",
          "refreshToken",
          "refreshTokenExpiresAt"
        ],
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token to send in the Authorization header as a Bearer token."
          },
          "accessTokenExpiresAt": {
            "type": "string",
            "description": "UTC time when the access token expires.",
            "format": "date-time"
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque refresh token used once to obtain a new token pair."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "description": "UTC time when the refresh token expires.",
            "format": "date-time"
          }
        },
        "description": "Access and refresh tokens issued for an authenticated session."
      },
      "ClientAddress": {
        "required": [
          "street",
          "buildingNumber",
          "postalCode",
          "city"
        ],
        "type": "object",
        "properties": {
          "street": {
            "type": "string",
            "description": "Street name."
          },
          "buildingNumber": {
            "type": "string",
            "description": "Building number, optionally with a letter or apartment, for example 12A or 12/4."
          },
          "postalCode": {
            "type": "string",
            "description": "Polish postal code in the NN-NNN format."
          },
          "city": {
            "type": "string",
            "description": "City."
          }
        },
        "description": "Postal address of a client."
      },
      "ClientResponse": {
        "required": [
          "id",
          "name",
          "address",
          "contactPerson",
          "phone",
          "email",
          "createdAt",
          "archivedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the client.",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "description": "Company or person name."
          },
          "address": {
            "description": "Postal address.",
            "$ref": "#/components/schemas/ClientAddress"
          },
          "contactPerson": {
            "type": "string",
            "description": "Contact person at the client."
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number."
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Contact email address."
          },
          "createdAt": {
            "type": "string",
            "description": "UTC time when the client was created.",
            "format": "date-time"
          },
          "archivedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "UTC time when the client was archived; null for active clients.",
            "format": "date-time"
          }
        },
        "description": "Client of the service company."
      },
      "CreateClientRequest": {
        "required": [
          "name",
          "address",
          "contactPerson",
          "phone"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Company or person name."
          },
          "address": {
            "description": "Postal address.",
            "$ref": "#/components/schemas/ClientAddress"
          },
          "contactPerson": {
            "type": "string",
            "description": "Contact person at the client."
          },
          "phone": {
            "type": "string",
            "description": "Contact phone number."
          },
          "email": {
            "type": [
              "null",
              "string"
            ],
            "description": "Optional contact email address."
          }
        },
        "description": "Data of a new client."
      },
      "CreateDeviceRequest": {
        "required": [
          "clientId",
          "serialNumber",
          "model",
          "manufacturer",
          "installationDate"
        ],
        "type": "object",
        "properties": {
          "clientId": {
            "type": "string",
            "description": "Identifier of an active client that owns the device.",
            "format": "uuid"
          },
          "serialNumber": {
            "type": "string",
            "description": "Serial number, unique across all devices regardless of letter case and surrounding spaces."
          },
          "model": {
            "type": "string",
            "description": "Device model."
          },
          "manufacturer": {
            "type": "string",
            "description": "Device manufacturer."
          },
          "installationDate": {
            "type": "string",
            "description": "Calendar date when the device was installed; cannot be in the future.",
            "format": "date"
          }
        },
        "description": "Data of a new device."
      },
      "CreateUserRequest": {
        "required": [
          "email",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address used as the login of the new account."
          },
          "password": {
            "type": "string",
            "description": "Initial password. At least 8 characters with an uppercase letter, a lowercase letter, a digit and a non-alphanumeric character."
          },
          "role": {
            "type": "string",
            "description": "Role of the new account: Admin, Dispatcher or Technician."
          }
        },
        "description": "Data of a new user account created by an administrator."
      },
      "DeviceResponse": {
        "required": [
          "id",
          "clientId",
          "serialNumber",
          "model",
          "manufacturer",
          "installationDate",
          "createdAt",
          "archivedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the device.",
            "format": "uuid"
          },
          "clientId": {
            "type": "string",
            "description": "Identifier of the client that owns the device.",
            "format": "uuid"
          },
          "serialNumber": {
            "type": "string",
            "description": "Unique serial number, stored trimmed and in upper case."
          },
          "model": {
            "type": "string",
            "description": "Device model."
          },
          "manufacturer": {
            "type": "string",
            "description": "Device manufacturer."
          },
          "installationDate": {
            "type": "string",
            "description": "Calendar date when the device was installed.",
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "description": "UTC time when the device was created.",
            "format": "date-time"
          },
          "archivedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "UTC time when the device was archived; null for active devices.",
            "format": "date-time"
          }
        },
        "description": "Device installed at a client and serviced by the company."
      },

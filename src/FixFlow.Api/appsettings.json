{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "FixFlow.Api",
    "Audience": "FixFlow.Clients",
    "AccessTokenLifetime": "00:15:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "Window": "00:01:00"
    }
  },
  "Seed": {
    "DemoUsers": {
      "Enabled": false
    }
  },
  "AllowedHosts": "*"
}
